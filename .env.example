# Base URL of the VCF Automation appliance (no trailing slash)
VCFA_BASE_URL=https://vcfa.example.com

# API refresh token generated once in the VCF Automation UI: sign in, go to the org
# you want to act as, then My Account > API Tokens > New. This is a long-lived token
# (90 days by default) that the server exchanges for short-lived (~1 hour) bearer
# access tokens on your behalf - it is never sent directly to the automation APIs.
VCFA_REFRESH_TOKEN=

# Tenant org name to authenticate as (the VM Apps org name shown in Provider
# Management Portal), e.g. vcf-e2e-vidm. Leave unset to authenticate at the provider
# ("system") level instead - only do this if your refresh token was generated there.
VCFA_ORG=

# Advanced: override the computed OAuth token endpoint if your instance's token
# exchange path differs from the documented default. Leave unset unless token
# exchange fails against the default path.
#   Default when VCFA_ORG is set:    /tm/oauth/tenant/<VCFA_ORG>/token
#   Default when VCFA_ORG is unset:  /oauth/provider/token
VCFA_TOKEN_URL=

# Set to false only against instances with self-signed certs you trust (e.g. lab environments)
VCFA_VERIFY_SSL=true

# Per-request timeout in seconds
VCFA_TIMEOUT=30

# Each VCF Automation service is versioned independently via ?apiVersion=. Defaults
# below match the current documented values; override only if your instance needs a
# different version (see /iaas/api/swagger/ui, /catalog/api/swagger, etc. on your
# appliance for the versions it actually supports).
VCFA_API_VERSION_IAAS=2021-07-15
VCFA_API_VERSION_CATALOG=2020-08-25
VCFA_API_VERSION_DEPLOYMENT=2020-08-25

# --- MCP server transport/auth (this server, not the VCF Automation API) ---

# "streamable-http" (default, network-reachable) or "stdio" (local subprocess,
# e.g. when launched directly by Claude Desktop/Code)
VCFA_MCP_TRANSPORT=streamable-http

VCFA_MCP_HOST=127.0.0.1
VCFA_MCP_PORT=8000

# Required when VCFA_MCP_TRANSPORT=streamable-http. Clients must send
# `Authorization: Bearer <this value>`. Generate one with:
#   openssl rand -hex 32
VCFA_MCP_BEARER_TOKEN=

# Comma-separated Host header allowlist (DNS-rebinding protection), e.g.
# VCFA_MCP_ALLOWED_HOSTS=vcf-automation-mcp.example.com,10.200.204.205:8000
# Only meaningful when VCFA_MCP_HOST is not 127.0.0.1/localhost (FastMCP
# auto-configures a loopback-only allowlist in that case). Left empty, no
# Host-header check is enforced and the bearer token is the only gate -
# fine as long as VCFA_MCP_BEARER_TOKEN is set, but set this too on a
# multi-tenant or untrusted network for defense in depth.
VCFA_MCP_ALLOWED_HOSTS=
